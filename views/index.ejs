<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>weekday warrior</title>
</head>
<body>
    <% if(fruits.length > 0) { %>
        <h3>Fruits is available</h3>
    <% } %>
    <ul>
        <% for(let i = 0; i < fruits.length; i++) { %>
            <li><%= fruits[i] %></li>
        <% } %>
    </ul>
    <%- htmlContent %>
    <h4><%= numbers.join(" ") %></h4>
    <%- include("footer.ejs")  %>
</body>
</html>