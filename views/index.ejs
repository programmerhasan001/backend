<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <% if(locals.randomName && locals.randomAdjective) { %>
    <h1>Hello <%= randomName %> <%= randomAdjective %></h1>
    <% } else {%>
    <h1>Generate a random name and adjective</h1>
    <% } %>
    <form action="/submit" method="post">
      <button type="submit">Submit</button>
    </form>
  </body>
</html>
